generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  country      String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Product {
  id                    String      @id @default(cuid())
  slug                  String      @unique
  name                  String
  category              String
  shortDesc             String
  description           String
  features              String
  specs                 String
  scenarios             String
  accessories           String
  delivery              String
  maintenance           String
  faq                   String
  priceUsd              Float
  stock                 Int         @default(10)
  imageCard             String
  imageHero             String
  imageDetail           String
  published             Boolean     @default(true)
  directPurchaseEnabled Boolean     @default(false)
  quoteOnly             Boolean     @default(false)
  productType           String      @default("hardware")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  orders                Order[]
  orderItems            OrderItem[]
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  userId             String
  user               User        @relation(fields: [userId], references: [id])
  productId          String?
  product            Product?    @relation(fields: [productId], references: [id])
  quantity           Int         @default(1)
  orderType          String      @default("purchase")
  status             String      @default("pending payment")
  expectedAmount     Float
  receivedAmount     Float?
  paymentAddress     String
  paymentNetwork     String      @default("Tron")
  paymentCurrency    String      @default("USDT")
  txHash             String?
  paymentStatus      String      @default("unpaid")
  verificationStatus String      @default("pending")
  customerName       String?
  customerEmail      String?
  contactMessaging   String?
  country            String?
  shippingAddress    String?
  orderNotes         String?
  adminNote          String?
  expiresAt          DateTime
  paidAt             DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  quantity     Int
  unitPriceUsd Float
  lineTotalUsd Float
}

model ContactSubmission {
  id              String   @id @default(cuid())
  name            String
  country         String?
  messaging       String?
  phone           String?
  email           String
  deviceQuantity  String?
  productInterest String?
  budget          String?
  message         String?
  source          String?
  createdAt       DateTime @default(now())
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}
