# Neon Postgres (required for production)
# DATABASE_URL = pooled connection string (Prisma + app runtime)
# DIRECT_URL   = direct connection string (migrations only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

JWT_SECRET="change-me-in-production"
ADMIN_EMAIL="admin@phonefarm.cyou"
ADMIN_PASSWORD="Admin@2026!"
TRON_API_KEY=""
USDT_TRC20_ADDRESS=""
SITE_URL="https://www.phonefarm.cyou"

