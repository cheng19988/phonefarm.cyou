# Neon Postgres — BOTH required locally and on Vercel (including build step).
# In Neon Console → Connect:
#   Pooled connection  → DATABASE_URL  (host often includes -pooler)
#   Direct connection  → DIRECT_URL    (no pooler; used by prisma migrate deploy)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="change-me-in-production"
ADMIN_EMAIL="admin@phonefarm.cyou"
ADMIN_PASSWORD="Admin@2026!"
TRON_API_KEY=""
USDT_TRC20_ADDRESS=""
SITE_URL="https://www.phonefarm.cyou"

# Google Search Console HTML tag verification (optional)
# GOOGLE_SITE_VERIFICATION="paste-token-from-search-console"

# Inquiry / order alerts (optional — failures do not block submissions)
# CONTACT_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/..."
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_NOTIFY_CHAT_ID=""

# Optional order cleanup cron
# CRON_SECRET=""
